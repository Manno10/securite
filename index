const leafletCSS = [
  "https://unpkg.com/leaflet@1.9.4/dist/leaflet.css",
  "https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.css"
];

const leafletJS = [
  "https://unpkg.com/leaflet@1.9.4/dist/leaflet.js",
  "https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.js",
  "https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.js"
];

function loadCSS(url) {
  const l=document.createElement("link");
  l.rel="stylesheet"; l.href=url;
  document.head.appendChild(l);
}

function loadScriptSequential(urls, index=0) {
  return new Promise((resolve,reject)=>{
    if(index>=urls.length) return reject(new Error("Leaflet indisponible"));
    const s=document.createElement("script");
    s.src=urls[index];
    s.onload=()=>resolve(urls[index]);
    s.onerror=()=>{s.remove();loadScriptSequential(urls,index+1).then(resolve).catch(reject)};
    document.head.appendChild(s);
  });
}

leafletCSS.forEach(loadCSS);

document.addEventListener("DOMContentLoaded", async ()=>{
  try {
    if(typeof L==="undefined") await loadScriptSequential(leafletJS);
    if(typeof L==="undefined") throw new Error("Leaflet non chargé");
    initApp();
  } catch(err) {
    document.getElementById("status").textContent="Impossible de charger Leaflet.";
    document.getElementById("status").className="status err";
    const f=document.getElementById("fatal");
    f.style.display="block";
    f.innerHTML="<b>La bibliothèque cartographique Leaflet n'a pas pu être chargée.</b><br><br>Le fichier contient bien les 224 postes, mais le navigateur bloque les scripts externes. Essaie l'ouverture directe dans Chrome avec Internet.";
  }
});

function initApp() {
  const deptSel=document.getElementById("dept");
  const communeSel=document.getElementById("commune");
  const q=document.getElementById("q");
  const status=document.getElementById("status");

  document.getElementById("planBtn").onclick=()=>setBase(
    document.body.classList.contains("night") ? dark : osm,
    "plan"
  );
  document.getElementById("satBtn").onclick=()=>setBase(esri,"satellite");

  function setTheme(mode){
    const night=mode==="night";
    document.body.classList.toggle("night",night);
    document.getElementById("dayBtn").classList.toggle("active",!night);
    document.getElementById("nightBtn").classList.toggle("active",night);

    // En mode nuit, si le fond plan est actif, passer au fond sombre.
    if(!map.hasLayer(esri)){
      setBase(night ? dark : osm,"plan");
    }
    localStorage.setItem("commissariats_theme",mode);
  }

  document.getElementById("dayBtn").onclick=()=>setTheme("day");
  document.getElementById("nightBtn").onclick=()=>setTheme("night");

  let visible=[...STATIONS];
  let markerLayer=L.layerGroup();
  let markers=new Map();
  let originMarker=null;
  let nearestMarker=null;
  let currentOrigin=null;
  let currentNearest=null;
  let routeLayers=[];

  const map=L.map("map",{zoomControl:true,preferCanvas:true}).setView([18.95,-72.75],8);

  const osm=L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
    maxZoom:19,
    attribution:"&copy; OpenStreetMap contributors"
  }).addTo(map);

  const esri=L.tileLayer("https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}", {
    maxZoom:19,
    attribution:"Tiles &copy; Esri"
  });

  const dark=L.tileLayer("https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png",{
    maxZoom:20,
    attribution:"&copy; OpenStreetMap &copy; CARTO"
  });

  let currentBase=osm;

  function setBase(layer,name){
    [osm,esri,dark].forEach(l=>{if(map.hasLayer(l)) map.removeLayer(l)});
    currentBase=layer;
    layer.addTo(map);
    document.getElementById("planBtn").classList.toggle("active",name==="plan");
    document.getElementById("satBtn").classList.toggle("active",name==="satellite");
  }
  markerLayer.addTo(map);

  const savedTheme=localStorage.getItem("commissariats_theme");
  if(savedTheme==="night") setTheme("night");

  const depts=[...new Set(STATIONS.map(s=>s.department))].sort((a,b)=>a.localeCompare(b,"fr"));
  deptSel.innerHTML='<option value="">Tous les départements</option>'+depts.map(d=>`<option>${escapeHtml(d)}</option>`).join("");

  function refreshCommunes() {
    const d=deptSel.value;
    const communes=[...new Set(STATIONS.filter(s=>!d||s.department===d).map(s=>s.commune))].sort((a,b)=>a.localeCompare(b,"fr"));
    communeSel.innerHTML='<option value="">Toutes les communes</option>'+communes.map(c=>`<option>${escapeHtml(c)}</option>`).join("");
  }

  function applyFilters(zoom=true) {
    const d=deptSel.value, c=communeSel.value, qq=q.value.trim().toLowerCase();
    visible=STATIONS.filter(s=>
      (!d||s.department===d) &&
      (!c||s.commune===c) &&
      (!qq||(`${s.name} ${s.address} ${s.commune} ${s.department}`).toLowerCase().includes(qq))
    );

    drawMarkers();
    updateMarkerLabels();
    renderList();

    document.getElementById("sN").textContent=visible.length;
    document.getElementById("sC").textContent=new Set(visible.map(s=>s.commune)).size;
    document.getElementById("sD").textContent=new Set(visible.map(s=>s.department)).size;

    if(zoom) zoomVisible();
  }

  function drawMarkers() {
    markerLayer.clearLayers();
    markers.clear();

    for(const s of visible) {
      const m=L.circleMarker([s.lat,s.lon], {
        radius:7,
        color:"#ffffff",
        weight:2,
        fillColor:"#b43b3b",
        fillOpacity:.97
      });

      m._stationData = s;
      m.bindTooltip(displayName(s.name,s.commune),{
        permanent:false,
        direction:"top",
        offset:[0,-8],
        className:"station-label",
        opacity:.96
      });

      m.bindPopup(`
        <div style="font-family:Arial,sans-serif;min-width:190px">
          <b>${escapeHtml(displayName(s.name,s.commune))}</b><br>
          <span>${escapeHtml(s.commune)} — ${escapeHtml(s.department)}</span>
          ${s.address?`<br><span>${escapeHtml(s.address)}</span>`:""}
          <br><small>${s.lat.toFixed(6)}, ${s.lon.toFixed(6)}</small>
        </div>
      `);

      m.addTo(markerLayer);
      markers.set(s.id,m);
    }
  }


  function updateMarkerLabels() {
    const z=map.getZoom();

    markers.forEach((m,id)=>{
      const s=m._stationData;
      if(!s) return;

      // Afficher les noms à partir d'un zoom local.
      if(z>=13) {
        if(!m.getTooltip()) {
          m.bindTooltip(displayName(s.name,s.commune),{
            permanent:true,
            direction:"top",
            offset:[0,-9],
            className:"station-label",
            opacity:.96
          });
        } else {
          const tt=m.getTooltip();
          if(tt && !tt.options.permanent) {
            m.unbindTooltip();
            m.bindTooltip(displayName(s.name,s.commune),{
              permanent:true,
              direction:"top",
              offset:[0,-9],
              className:"station-label",
              opacity:.96
            });
          }
        }
        m.openTooltip();
      } else {
        const tt=m.getTooltip();
        if(tt && tt.options.permanent) {
          m.unbindTooltip();
          m.bindTooltip(displayName(s.name,s.commune),{
            permanent:false,
            direction:"top",
            offset:[0,-8],
            className:"station-label",
            opacity:.96
          });
        }
        m.closeTooltip();
      }
    });
  }

  function renderList() {
    const el=document.getElementById("list");
    el.innerHTML="";
    const groups={};
    visible.forEach(s=>{(groups[s.department]??={});(groups[s.department][s.commune]??=[]).push(s)});

    for(const dep of Object.keys(groups).sort((a,b)=>a.localeCompare(b,"fr"))) {
      let total=Object.values(groups[dep]).reduce((n,a)=>n+a.length,0);
      el.insertAdjacentHTML("beforeend",`<div class="dept-h"><span>${escapeHtml(dep)}</span><span>${total}</span></div>`);
      for(const com of Object.keys(groups[dep]).sort((a,b)=>a.localeCompare(b,"fr"))) {
        el.insertAdjacentHTML("beforeend",`<div class="commune-h">${escapeHtml(com)} · ${groups[dep][com].length}</div>`);
        for(const s of groups[dep][com]) {
          const r=document.createElement("div");
          r.className="st";
          r.innerHTML=`<div class="dot"></div><div><div class="nm">${escapeHtml(displayName(s.name,s.commune))}</div><div class="mt">${escapeHtml(s.address||"Adresse non renseignée")}</div></div>`;
          r.onclick=()=>{
            map.setView([s.lat,s.lon],16);
            const m=markers.get(s.id);
            if(m) m.openPopup();
          };
          el.appendChild(r);
        }
      }
    }
  }

  function zoomVisible() {
    if(!visible.length) return;
    const bounds=L.latLngBounds(visible.map(s=>[s.lat,s.lon]));
    map.fitBounds(bounds,{padding:[30,30],maxZoom:14});
  }

  function nearestTo(lat,lon) {
    let best=null, bd=Infinity;
    for(const s of STATIONS) {
      const d=haversine(lat,lon,s.lat,s.lon);
      if(d<bd) {bd=d;best=s}
    }
    return {station:best,distance:bd};
  }


  async function fetchRoute(from,to) {
    const url=`https://router.project-osrm.org/route/v1/driving/${from.lon},${from.lat};${to.lon},${to.lat}?overview=full&geometries=geojson`;
    try {
      const r=await fetch(url);
      if(!r.ok) throw new Error("OSRM HTTP "+r.status);
      const j=await r.json();
      if(!j.routes || !j.routes.length) return null;
      const rt=j.routes[0];
      return {
        distance:rt.distance,
        duration:rt.duration,
        coords:rt.geometry.coordinates.map(c=>[c[1],c[0]])
      };
    } catch(err) {
      console.warn("OSRM indisponible",err);
      return null;
    }
  }

  function clearRoute() {
    routeLayers.forEach(l=>map.removeLayer(l));
    routeLayers=[];
    document.getElementById("clearRouteBtn").style.display="none";
  }

  async function updateRoadMetrics(from,to) {
    document.getElementById("nRoad").textContent="…";
    document.getElementById("nTime").textContent="…";
    const r=await fetchRoute(from,to);
    if(!r) {
      document.getElementById("nRoad").textContent="n/d";
      document.getElementById("nTime").textContent="n/d";
      return null;
    }
    document.getElementById("nRoad").textContent=formatDistance(r.distance/1000);
    document.getElementById("nTime").textContent=formatDuration(r.duration);
    return r;
  }

  async function drawRoute() {
    if(!currentOrigin || !currentNearest) return;
    clearRoute();

    document.getElementById("routeBtn").textContent="Calcul en cours…";
    document.getElementById("routeBtn").disabled=true;

    const r=await fetchRoute(currentOrigin,currentNearest);

    document.getElementById("routeBtn").textContent="Recalculer l'itinéraire";
    document.getElementById("routeBtn").disabled=false;

    if(!r) {
      const fallback=L.polyline(
        [[currentOrigin.lat,currentOrigin.lon],[currentNearest.lat,currentNearest.lon]],
        {color:"#2e78b7",weight:4,dashArray:"8 8",opacity:.9}
      ).addTo(map);
      routeLayers.push(fallback);
      map.fitBounds(fallback.getBounds().pad(.25));
      document.getElementById("clearRouteBtn").style.display="block";
      document.getElementById("nRoad").textContent="n/d";
      document.getElementById("nTime").textContent="n/d";
      document.getElementById("status").textContent=
        "Itinéraire routier indisponible — ligne directe affichée.";
      document.getElementById("status").className="status err";
      return;
    }

    const halo=L.polyline(r.coords,{color:"#2e78b7",weight:10,opacity:.18}).addTo(map);
    const line=L.polyline(r.coords,{color:"#1f5f99",weight:5,opacity:.95}).addTo(map);
    routeLayers.push(halo,line);

    map.fitBounds(line.getBounds().pad(.18));
    document.getElementById("clearRouteBtn").style.display="block";

    document.getElementById("nRoad").textContent=formatDistance(r.distance/1000);
    document.getElementById("nTime").textContent=formatDuration(r.duration);

    document.getElementById("status").textContent=
      "Itinéraire calculé : "+formatDistance(r.distance/1000)+
      " · durée approximative "+formatDuration(r.duration)+".";
    document.getElementById("status").className="status ok";
  }

  function setOrigin(lat,lon,label) {
    clearRoute();

    if(originMarker) map.removeLayer(originMarker);
    if(nearestMarker) map.removeLayer(nearestMarker);

    currentOrigin={lat,lon};

    originMarker=L.circleMarker([lat,lon],{
      radius:9,color:"#fff",weight:2.5,fillColor:"#1f7a5a",fillOpacity:1
    }).addTo(map).bindPopup(label||"Point choisi").openPopup();

    const r=nearestTo(lat,lon);
    const s=r.station;
    currentNearest=s;

    nearestMarker=L.circleMarker([s.lat,s.lon],{
      radius:10,color:"#0c1f18",weight:2.5,fillColor:"#c58a1b",fillOpacity:1
    }).addTo(map).bindPopup("<b>"+escapeHtml(displayName(s.name,s.commune))+"</b>");

    document.getElementById("nearest").classList.add("show");
    document.getElementById("nName").textContent=displayName(s.name,s.commune);
    document.getElementById("nLoc").textContent=s.commune+" — "+s.department;
    document.getElementById("nDist").innerHTML=formatDistance(r.distance)+" <small>à vol d'oiseau</small>";

    document.getElementById("nRoad").textContent="…";
    document.getElementById("nTime").textContent="…";

    document.getElementById("mapsBtn").onclick=()=>window.open(
      `https://www.google.com/maps/dir/?api=1&origin=${lat},${lon}&destination=${s.lat},${s.lon}&travelmode=driving`,
      "_blank"
    );

    document.getElementById("routeBtn").onclick=drawRoute;

    map.fitBounds(L.latLngBounds([[lat,lon],[s.lat,s.lon]]).pad(.45),{maxZoom:15});

    /* Tracer automatiquement l'itinéraire dès que le poste le plus proche est trouvé. */
    drawRoute();
  }

  map.on("click",e=>setOrigin(e.latlng.lat,e.latlng.lng,"Point choisi"));
  map.on("zoomend",updateMarkerLabels);

  deptSel.onchange=()=>{refreshCommunes();applyFilters(true)};
  communeSel.onchange=()=>applyFilters(true);
  q.oninput=()=>applyFilters(false);

  document.getElementById("haitiBtn").onclick=()=>{
    deptSel.value="";
    refreshCommunes();
    communeSel.value="";
    q.value="";
    applyFilters(true);
  };

  document.getElementById("clearRouteBtn").onclick=clearRoute;

  document.getElementById("geoBtn").onclick=()=>{
    if(!navigator.geolocation) return alert("Géolocalisation indisponible.");
    navigator.geolocation.getCurrentPosition(
      p=>setOrigin(p.coords.latitude,p.coords.longitude,"Ma position"),
      ()=>alert("Impossible d'obtenir la position."),
      {enableHighAccuracy:true,timeout:12000,maximumAge:0}
    );
  };

  refreshCommunes();
  applyFilters(true);

  setTimeout(()=>{
    map.invalidateSize(true);
    zoomVisible();
  },250);

  status.textContent="Carte chargée — 224 postes disponibles.";
  status.className="status ok";
}

function escapeHtml(v) {
  return String(v??"").replace(/[&<>"']/g,m=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#039;"}[m]));
}

function displayName(n, commune="") {
  const nom=String(n||"").trim();
  const com=String(commune||"").trim();

  if(!nom.toLowerCase().startsWith("commissariat / poste")) return nom;
  if(!com) return "Commissariat";

  const DU = new Set([
    "Cap-Haïtien","Môle-Saint-Nicolas","Borgne","Limbé",
    "Petit-Goâve","Grand-Goâve","Trou-du-Nord"
  ]);

  const DE_LA = new Set([
    "La Chapelle","La Victoire","La Vallée-de-Jacmel"
  ]);

  const DES = new Set([
    "Gonaïves","Cayes","Coteaux","Anglais","Verrettes"
  ]);

  const DE_L = new Set([
    "Arcahaie","Asile","Estère"
  ]);

  if(com.startsWith("L'") || com.startsWith("L’")) {
    return "Commissariat de " + com.toLowerCase().replace(/^l['’]/,"l’");
  }
  if(com.startsWith("Le ")) return "Commissariat du " + com.slice(3);
  if(com.startsWith("Les ")) return "Commissariat des " + com.slice(4);
  if(com.startsWith("La ")) return "Commissariat de la " + com.slice(3);

  if(DU.has(com)) return "Commissariat du " + com;
  if(DE_L.has(com)) return "Commissariat de l’" + com;
  if(DE_LA.has(com)) return "Commissariat de la " + com.replace(/^La\s+/,"");
  if(DES.has(com)) return "Commissariat des " + com.replace(/^Les\s+/,"");

  if(/^[AEIOUYÀÂÄÉÈÊËÎÏÔÖÙÛÜH]/i.test(com)) {
    return "Commissariat d’" + com;
  }

  return "Commissariat de " + com;
}

function haversine(a,b,c,d) {
  const R=6371, rad=x=>x*Math.PI/180;
  const dLat=rad(c-a), dLon=rad(d-b);
  const h=Math.sin(dLat/2)**2 + Math.cos(rad(a))*Math.cos(rad(c))*Math.sin(dLon/2)**2;
  return R*2*Math.atan2(Math.sqrt(h),Math.sqrt(1-h));
}

function formatDistance(km) {
  return km<1 ? Math.round(km*1000)+" m" : km.toFixed(1)+" km";
}

function formatDuration(seconds) {
  const min=Math.round(seconds/60);
  if(min<60) return min+" min";
  const h=Math.floor(min/60);
  const m=min%60;
  return h+" h "+String(m).padStart(2,"0");
}
