<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Poste le plus proche — Commissariats d'Haïti</title>


<style>
:root{
  --navy:#0b1f33;
  --navy-2:#14324d;
  --blue:#1f5f99;
  --blue-2:#2e78b7;
  --blue-soft:#eaf2f8;
  --bg:#f3f6f9;
  --panel:#ffffff;
  --line:#d8e0e8;
  --text:#1e2f3f;
  --muted:#6c7b88;
  --success:#1f7a5a;
  --warning:#c58a1b;
  --danger:#b43b3b;
  --shadow:0 8px 28px rgba(15,35,55,.10);
  --metric-bg:#0b2b23;
  --metric-text:#ffffff;
}

body.night{
  --bg:#0b1218;
  --panel:#101b25;
  --panel2:#172735;
  --line:#2b3e4d;
  --text:#e7eef4;
  --muted:#a3b2bf;
  --blue-soft:#142434;
  --metric-bg:#081d18;
  --metric-text:#f4f8fb;
}
*{box-sizing:border-box}
html,body{
  margin:0;
  height:100%;
  font-family:Inter,Segoe UI,Arial,sans-serif;
  background:var(--bg);
  color:var(--text);
}
body{overflow:hidden}
.app{
  height:100vh;
  display:grid;
  grid-template-columns:400px 1fr;
}
.side{
  background:var(--panel);
  border-right:1px solid var(--line);
  display:flex;
  flex-direction:column;
  min-width:0;
  overflow:hidden;
  box-shadow:4px 0 20px rgba(25,50,75,.06);
  z-index:700;
}
.head{
  padding:20px 20px 18px;
  background:linear-gradient(135deg,var(--navy),var(--navy-2));
  color:#fff;
  border-bottom:1px solid rgba(255,255,255,.08);
}
.head h1{
  font-size:19px;
  margin:0;
  font-weight:700;
  letter-spacing:.1px;
}
.head .sub{
  margin-top:5px;
  font-size:11px;
  color:#dbe6ef;
  line-height:1.45;
}
.head::after{
  content:"SYSTÈME D’APPUI À LA SÉCURITÉ";
  display:inline-block;
  margin-top:10px;
  padding:4px 8px;
  border:1px solid rgba(255,255,255,.28);
  border-radius:5px;
  font-size:8.5px;
  letter-spacing:1.2px;
  color:#f4f7fa;
}
.controls{
  padding:15px 18px 13px;
  display:grid;
  gap:10px;
  border-bottom:1px solid var(--line);
  background:#fbfcfd;
}
label{
  display:block;
  font-size:9.5px;
  color:var(--muted);
  font-weight:700;
  text-transform:uppercase;
  letter-spacing:.6px;
  margin-bottom:5px;
}
select,input,button{
  width:100%;
  min-height:40px;
  border-radius:7px;
  border:1px solid #cfd9e2;
  background:#fff;
  color:var(--text);
  padding:0 11px;
  font:inherit;
  font-size:13px;
}
select:focus,input:focus{
  outline:none;
  border-color:var(--blue);
  box-shadow:0 0 0 3px rgba(31,95,153,.10);
}
button{
  cursor:pointer;
  font-weight:700;
  transition:.15s;
}
button:hover{transform:translateY(-1px)}
.primary{
  background:var(--blue);
  color:#fff;
  border-color:var(--blue);
}
.primary:hover{background:#184f80}
.row{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:8px;
}
.stats{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:8px;
  padding:12px 18px;
  background:#fff;
  border-bottom:1px solid var(--line);
}
.stat{
  background:#f7fafc;
  border:1px solid var(--line);
  border-radius:8px;
  padding:10px 8px;
  text-align:center;
}
.stat .v{
  font-size:21px;
  line-height:1;
  font-weight:800;
  color:var(--navy-2);
}
.stat .k{
  margin-top:5px;
  font-size:8.5px;
  color:var(--muted);
  text-transform:uppercase;
  letter-spacing:.45px;
}
.nearest{
  display:none;
  margin:12px 16px 0;
  border:1px solid #cfdce8;
  border-radius:10px;
  background:#f8fbfd;
  box-shadow:0 5px 18px rgba(20,50,75,.06);
  overflow:hidden;
}
.nearest.show{display:block}
.eyebrow{
  padding:10px 12px 0;
  font-size:9px;
  color:var(--blue);
  font-weight:800;
  text-transform:uppercase;
  letter-spacing:1px;
}
.nearest-name{
  padding:3px 12px 0;
  font-size:16px;
  font-weight:800;
  color:var(--navy);
}
.nearest-loc{
  padding:3px 12px 8px;
  font-size:11px;
  color:var(--muted);
  border-bottom:1px solid var(--line);
}
.metric{
  font-size:17px;
  font-weight:800;
  color:var(--warning);
  margin-top:8px;
}
.metric small{
  font-size:9px;
  color:var(--muted);
  font-weight:700;
  text-transform:uppercase;
}
.nearest button{
  border-radius:6px;
}
.status{
  padding:9px 16px;
  font-size:10.5px;
  color:var(--muted);
  border-bottom:1px solid var(--line);
  background:#fbfcfd;
}
.status.ok{
  color:var(--success);
  background:#f3faf7;
}
.status.err{
  color:var(--danger);
  background:#fff7f7;
}
.list{
  overflow:auto;
  flex:1;
  padding:8px 10px 18px;
  background:#fff;
}
.list::-webkit-scrollbar{width:8px}
.list::-webkit-scrollbar-thumb{background:#c8d3dd;border-radius:8px}
.dept-h{
  position:sticky;
  top:0;
  z-index:2;
  background:#eef4f8;
  padding:8px 9px;
  font-size:11.5px;
  font-weight:800;
  color:var(--navy-2);
  border:1px solid #dce5ec;
  border-radius:6px;
  margin-top:5px;
  display:flex;
  justify-content:space-between;
}
.commune-h{
  padding:8px 8px 3px;
  font-size:9.5px;
  color:var(--blue);
  font-weight:800;
  text-transform:uppercase;
  letter-spacing:.5px;
}
.st{
  padding:8px 9px;
  border-radius:6px;
  cursor:pointer;
  display:flex;
  gap:8px;
  border-left:3px solid transparent;
}
.st:hover{
  background:#f5f8fb;
  border-left-color:var(--blue-2);
}
.dot{
  width:7px;
  height:7px;
  border-radius:50%;
  background:var(--danger);
  margin-top:5px;
  flex:none;
}
.nm{
  font-size:12px;
  font-weight:700;
  color:var(--text);
}
.mt{
  font-size:10px;
  color:var(--muted);
  margin-top:2px;
}
.mapwrap{
  position:relative;
  min-width:0;
  background:#dceaf2;
}
#map{
  height:100%;
  width:100%;
  background:#dceaf2;
}
#fatal{
  display:none;
  position:absolute;
  inset:0;
  background:#eef4f8;
  color:var(--navy);
  padding:30px;
  font-size:15px;
  z-index:20;
}
.badge{
  position:absolute;
  right:14px;
  bottom:14px;
  z-index:500;
  background:rgba(255,255,255,.94);
  color:var(--navy-2);
  border:1px solid #ccd8e2;
  border-radius:7px;
  padding:7px 10px;
  font-size:9.5px;
  font-weight:700;
  box-shadow:0 3px 14px rgba(15,35,55,.10);
}
.leaflet-control-layers,
.leaflet-bar{
  box-shadow:0 3px 14px rgba(15,35,55,.12)!important;
  border:1px solid #cbd6df!important;
}
.leaflet-popup-content-wrapper{
  border-radius:8px;
  box-shadow:var(--shadow);
}
.leaflet-popup-content{
  font-family:Inter,Segoe UI,Arial,sans-serif;
}
#clearRouteBtn{
  font-weight:700!important;
  border-radius:7px!important;
  box-shadow:0 4px 14px rgba(15,35,55,.12);
}
@media(max-width:850px){
  .app{
    grid-template-columns:1fr;
    grid-template-rows:56% 44%;
  }
  .side{
    border-right:0;
    border-bottom:1px solid var(--line);
  }
}

.leaflet-tooltip.station-label{
  background:rgba(255,255,255,.94);
  color:#0b1f33;
  border:1px solid #c7d3df;
  border-radius:5px;
  box-shadow:0 2px 8px rgba(15,35,55,.12);
  font-size:10.5px;
  font-weight:700;
  padding:3px 6px;
  white-space:nowrap;
}
.leaflet-tooltip.station-label:before{
  display:none;
}


.display-panel{
  padding:12px 18px 14px;
  border-bottom:1px solid var(--line);
  background:var(--panel);
}
.display-title{
  font-size:9.5px;
  font-weight:800;
  color:var(--muted);
  text-transform:uppercase;
  letter-spacing:.7px;
  margin-bottom:8px;
}
.map-style-grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:8px;
}
.map-style-btn,.theme-btn{
  min-height:38px;
  background:var(--panel);
  color:var(--text);
  border:1px solid var(--line);
}
.map-style-btn.active,.theme-btn.active{
  background:var(--blue);
  color:white;
  border-color:var(--blue);
}
.theme-row{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:8px;
  margin-top:8px;
}
.metric-card{
  background:var(--metric-bg)!important;
  border:1px solid rgba(255,255,255,.08)!important;
}
.metric-card .metric-value{
  color:var(--metric-text)!important;
  font-size:18px!important;
  font-weight:800!important;
}
.metric-card .metric-label{
  color:#c7d5df!important;
  font-size:8.5px!important;
  text-transform:uppercase;
  letter-spacing:.45px;
}
body.night .controls,
body.night .status,
body.night .list,
body.night .stats{
  background:var(--panel);
}
body.night select,
body.night input,
body.night button:not(.primary):not(.map-style-btn):not(.theme-btn){
  background:#0e1a23;
  color:var(--text);
  border-color:var(--line);
}
body.night .stat{
  background:#0d1922;
}
body.night .dept-h{
  background:#182a38;
  color:#dce8f1;
  border-color:var(--line);
}
body.night .nearest{
  background:#132331;
  border-color:var(--line);
}
body.night .nearest-loc{
  border-color:var(--line);
}
body.night .st:hover{
  background:#162633;
}

</style>

</head>
