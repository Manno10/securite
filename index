<div class="app">
  <aside class="side">
    <div class="head">
      <h1>Carte des commissariats de police</h1>
      <div class="sub">Référentiel cartographique national · Recherche du poste le plus proche et calcul d’itinéraire</div>
    </div>

    <div class="controls">
      <div><label>Département</label><select id="dept"></select></div>
      <div><label>Commune</label><select id="commune"><option value="">Toutes les communes</option></select></div>
      <div><label>Recherche</label><input id="q" placeholder="Nom, adresse, commune…"></div>
      <div class="row">
        <button class="primary" id="haitiBtn">Vue nationale</button>
        <button id="geoBtn">Ma position</button>
      </div>
    </div>

    <div class="display-panel">
      <div class="display-title">Affichage</div>
      <div class="map-style-grid">
        <button class="map-style-btn active" id="planBtn">Plan</button>
        <button class="map-style-btn" id="satBtn">Satellite</button>
      </div>
      <div class="theme-row">
        <button class="theme-btn active" id="dayBtn">☀ Jour</button>
        <button class="theme-btn" id="nightBtn">🌙 Nuit</button>
      </div>
    </div>

    <div class="stats">
      <div class="stat"><div class="v" id="sN">0</div><div class="k">postes</div></div>
      <div class="stat"><div class="v" id="sC">0</div><div class="k">communes</div></div>
      <div class="stat"><div class="v" id="sD">0</div><div class="k">départ.</div></div>
    </div>

    <div class="nearest" id="nearest">
      <div class="eyebrow">Poste le plus proche</div>
      <div class="nearest-name" id="nName">—</div>
      <div class="nearest-loc" id="nLoc">—</div>
      <div class="metric" id="nDist">—</div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:8px">
        <div class="metric-card" style="border-radius:9px;padding:8px;text-align:center">
          <div id="nRoad" class="metric-value">—</div>
          <div class="metric-label">par la route</div>
        </div>
        <div class="metric-card" style="border-radius:9px;padding:8px;text-align:center">
          <div id="nTime" class="metric-value">—</div>
          <div class="metric-label">temps estimé</div>
        </div>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:10px">
        <button class="primary" id="routeBtn">Recalculer l'itinéraire</button>
        <button id="mapsBtn">Ouvrir dans Google Maps</button>
      </div>
    </div>

    <div id="status" class="status">Chargement de la carte…</div>
    <div id="list" class="list"></div>
  </aside>

  <main class="mapwrap">
    <div id="map"></div>
    <div id="fatal"></div>
    <button id="clearRouteBtn" style="display:none;position:absolute;top:12px;right:12px;z-index:600;width:auto;padding:0 12px;background:#fff;color:#18352b;border:1px solid #cbd5db">Effacer l'itinéraire</button>
    <div class="badge">Référentiel cartographique · 224 points</div>
  </main>
</div>

